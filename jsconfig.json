{
  "compilerOptions": {
    "target": "ES6",
    "lib": ["ES6"],
    "allowJs": true,
    "checkJs": false,
    "noEmit": true,
    "skipLibCheck": true,
    "moduleResolution": "node",
    "experimentalDecorators": true,
    "noImplicitAny": false
  },
  "include": [
    "Unity.d.ts",
    "Feather.d.ts",
    "Project.d.ts",
    "Package.*.d.ts",
    "**/*.js",
    "**/*.jsu",
    "**/*.jsfeather"
  ],
  "exclude": [
    "Unity.*.d.ts",
    "node_modules",
    "Library/**/*",
    "Logs/**/*",
    "Temp/**/*",
    "UserSettings/**/*"
  ]
}
